{
  "mcpServers": {
    "postgres": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${GYMFLOW_PG_URL:-postgresql://gymflow:gymflow@localhost:5433/gymflow}"
      ]
    },
    "angular-cli": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@angular/cli@latest", "mcp"]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp@latest"]
    }
  }
}
